es":{"href":"#"},"components":[{"name":"Film Card Image Wrapper","classes":["film-card-image-wrapper"],"components":[{"type":"image","name":"Film Card Image","resizable":{"ratioDefault":1},"classes":["film-card-image"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=%22horror%20movie%20poster%22&w=360&h=520","alt":"Фильм","loading":"lazy"}},{"name":"Film Card Depth Overlay","classes":["film-card-depth-overlay"],"attributes":{"id":"i3waz9"}}]},{"name":"Film Card Info","classes":["film-card-info"],"attributes":{"id":"iwng0k"},"components":[{"type":"text","name":"Film Card Title","classes":["film-card-title"],"attributes":{"id":"ipzit6-2"},"components":[{"type":"textnode","content":"Кровь и шёпот"}]},{"type":"text","name":"Film Card Year","classes":["film-card-year"],"attributes":{"id":"i5410a-2"},"components":[{"type":"textnode","content":"2020"}]}]}]}]},{"tagName":"li","name":"Film Card Item","classes":["film-card-item"],"components":[{"type":"link","name":"Film Card Link","editable":false,"classes":["group","film-card-link"],"attributes":{"href":"#"},"components":[{"name":"Film Card Image Wrapper","classes":["film-card-image-wrapper"],"components":[{"type":"image","name":"Film Card Image","resizable":{"ratioDefault":1},"classes":["film-card-image"],"attributes":{"src":"https://app.grapesjs.com/api/assets/random-image?query=%22documentary%20poster%22&w=360&h=520","alt":"Фильм","loading":"lazy"}},{"name":"Film Card Depth Overlay","classes":["film-card-depth-overlay"],"attributes":{"id":"ifopoh"}}]},{"name":"Film Card Info","classes":["film-card-info"],"attributes":{"id":"ifyqk5"},"components":[{"type":"text","name":"Film Card Title","classes":["film-card-title"],"attributes":{"id":"imngr4-2"},"components":[{"type":"textnode","content":"Пульс города"}]},{"type":"text","name":"Film Card Year","classes":["film-card-year"],"attributes":{"id":"iye8in-2"},"components":[{"type":"textnode","content":"2023"}]}]}]}]}]}]}]}]}]},{"tagName":"footer","name":"Footer","classes":["footer"],"attributes":{"id":"igr7p8"}},{"type":"script","attributes":{"data-scope":"hero-slider"},"components":[{"type":"textnode","content":"\n(function(){\n  const root = document.querySelector('[data-js=\"hero-slider\"]');\n  if (!root) return;\n  const slides = Array.from(root.querySelectorAll('.hero-slide'));\n  const prevBtn = root.querySelector('.hero-nav.prev');\n  const nextBtn = root.querySelector('.hero-nav.next');\n  let index = slides.findIndex(s => s.classList.contains('is-active'));\n  if (index < 0) index = 0;\n\n  function update(to){\n    slides.forEach((s,i)=>s.classList.toggle('is-active', i===to));\n    root.setAttribute('aria-label', `Промо карусель (слайд ${to+1} из ${slides.length})`);\n    index = to;\n  }\n  function next(){ update((index+1)%slides.length); }\n  function prev(){ update((index-1+slides.length)%slides.length); }\n\n  prevBtn && prevBtn.addEventListener('click', prev);\n  nextBtn && nextBtn.addEventListener('click', next);\n\n  root.setAttribute('tabindex','0');\n  root.addEventListener('keydown', (e)=>{\n    if (e.key === 'ArrowRight') { e.preventDefault(); next(); }\n    if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }\n  });\n\n  let startX=0, startY=0, isTouch=false;\n  root.addEventListener('touchstart', (e)=>{ isTouch=true; const t=e.touches[0]; startX=t.clientX; startY=t.clientY; }, {passive:true});\n  root.addEventListener('touchend', (e)=>{\n    if(!isTouch) return;\n    const t=e.changedTouches[0];\n    const dx=t.clientX-startX, dy=t.clientY-startY;\n    if (Math.abs(dx)>40 && Math.abs(dx)>Math.abs(dy)){\n      dx<0 ? next() : prev();\n    }\n    isTouch=false;\n  });\n\n  // Ensure correct initial ARIA label\n  root.setAttribute('aria-label', `Промо карусель (слайд ${index+1} из ${slides.length})`);\n})();\n"}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","void":true,"attributes":{"charset":"utf-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1"}},{"tagName":"title","type":"text","name":"Document Title","components":[{"type":"textnode","content":"PIX — Онлайн-кинотеатр"}]},{"tagName":"link","name":"Font Headings","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Bebas+Neue:wght@400&family=Montserrat:wght@400;500;600;700&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"ru"}}},"id":"mdS1g92Z0eNGDz1c","minHeight":"500px"}],"id":"o8GMOxY1RNTRWTUf"}],"symbols":[],"custom":{"projectType":"web","id":""}}